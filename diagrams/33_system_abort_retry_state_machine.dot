digraph system_abort_retry_state_machine {
    graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica",
           fontcolor="#e6edf3", labelloc="t", fontsize=20,
           label="GoalManager.note_system_abort: retry, don't judge garbage, cap and fall back"];
    node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d",
           style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18",
           fillcolor="#161b22"];
    edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7",
           penwidth=1.6, arrowsize=0.9];

    active [label="active\nconsecutive_system_aborts = 0", shape=oval, color="#3fb950", fillcolor="#12351f"];
    abort1 [label="system-issued abort #1\n(watchdog / lease / timeout)", color="#f0883e", fillcolor="#161b22"];
    retry1 [label="retry SAME in-flight prompt\nconsecutive_system_aborts = 1\n\"↻ retrying the same step (1/3)\"", color="#39c5cf", fillcolor="#0d2e2e"];

    abort2 [label="system-issued abort #2", color="#f0883e", fillcolor="#161b22"];
    retry2 [label="retry SAME prompt again\nconsecutive_system_aborts = 2\n(2/3)", color="#39c5cf", fillcolor="#0d2e2e"];

    abort3 [label="system-issued abort #3\n(cap: DEFAULT_MAX_CONSECUTIVE_SYSTEM_ABORTS)", color="#f85149", fillcolor="#161b22", penwidth=3];
    pause [label="fall back to the existing\nrecoverable auto-pause\n\"⏸ cancelled by <issuer> 3x in a row —\n/goal resume to retry\"", color="#d29922", fillcolor="#1f2937", penwidth=3];

    success [label="a turn reaches the judge\nwith real output", color="#3fb950", fillcolor="#1f2937"];
    reset [label="consecutive_system_aborts\nresets to 0", shape=oval, color="#3fb950", fillcolor="#12351f", penwidth=3];

    userint [label="genuine user Ctrl+C\n(interrupt_issuer() == None)", color="#bc8cff", fillcolor="#161b22"];
    userpause [label="unchanged: immediate\nauto-pause, no retry", color="#bc8cff", fillcolor="#1f2937"];

    active -> abort1 -> retry1 -> abort2 -> retry2 -> abort3 -> pause;
    retry1 -> success [style=dashed, label="  (a clean turn\n  at any point)", fontcolor="#3fb950", color="#3fb950"];
    success -> reset;
    reset -> active [style=dashed];
    pause -> active [label="/goal resume", color="#d29922", style=dashed];

    active -> userint [style=dashed, color="#bc8cff"];
    userint -> userpause [color="#bc8cff"];
}
